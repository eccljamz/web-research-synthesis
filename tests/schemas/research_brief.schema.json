{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchBrief",
  "description": "Formal JSON Schema contract for autonomous web research synthesized brief adhering to R3 and R4 requirements.",
  "type": "object",
  "required": [
    "brief_id",
    "topic",
    "generated_at",
    "sub_queries",
    "executive_summary",
    "thematic_sections",
    "key_takeaways",
    "sources",
    "metadata"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^brief-[a-zA-Z0-9_-]+$",
      "description": "Unique identifier for the research brief"
    },
    "topic": {
      "type": "string",
      "minLength": 5,
      "description": "The primary user research topic or question"
    },
    "generated_at": {
      "type": "string",
      "minLength": 10,
      "description": "ISO 8601 UTC timestamp of brief synthesis"
    },
    "sub_queries": {
      "type": "array",
      "minItems": 2,
      "description": "Orthogonal sub-queries generated by query decomposition",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "type": "object",
            "required": ["query_text"],
            "properties": {
              "subquery_id": { "type": "string" },
              "query_text": { "type": "string", "minLength": 3 },
              "facet": { "type": "string" }
            }
          }
        ]
      }
    },
    "executive_summary": {
      "type": "string",
      "minLength": 80,
      "description": "High-level executive summary synthesizing major findings with inline citations"
    },
    "thematic_sections": {
      "type": "array",
      "minItems": 2,
      "description": "Thematic deep-dive sections clustering findings and claims",
      "items": {
        "type": "object",
        "required": ["section_id", "title"],
        "anyOf": [
          { "required": ["narrative"] },
          { "required": ["content"] }
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "narrative": {
            "type": "string",
            "minLength": 30
          },
          "content": {
            "type": "string",
            "minLength": 30
          },
          "citation_indices": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "integer" },
                { "type": "string" }
              ]
            }
          },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_findings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_text"],
              "properties": {
                "claim_id": { "type": "string" },
                "claim_text": { "type": "string", "minLength": 10 },
                "citation_keys": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      { "type": "string" },
                      { "type": "integer" }
                    ]
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              }
            }
          }
        }
      }
    },
    "key_takeaways": {
      "type": "array",
      "minItems": 3,
      "description": "Bulleted key takeaways and critical strategic findings",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 10
          },
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "takeaway_id": { "type": "string" },
              "text": { "type": "string", "minLength": 10 },
              "citation_indices": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "integer" },
                    { "type": "string" }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "description": "Bibliographic sources with metadata and citation indexes",
      "items": {
        "type": "object",
        "required": ["source_id", "url", "title", "snippet"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^(SRC-\\d+|\\d+|src-[a-zA-Z0-9_-]+)$"
          },
          "citation_index": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "minLength": 5
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "snippet": {
            "type": "string",
            "minLength": 15
          },
          "author": {
            "type": ["string", "null"]
          },
          "published_date": {
            "type": ["string", "null"]
          },
          "publish_date": {
            "type": ["string", "null"]
          },
          "domain": {
            "type": "string"
          },
          "attributed_claim_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "retrieval_mode",
        "total_sources_scanned",
        "total_claims_extracted"
      ],
      "properties": {
        "retrieval_mode": {
          "type": "string",
          "enum": ["mock", "live"]
        },
        "total_sources_scanned": {
          "type": "integer",
          "minimum": 1
        },
        "total_claims_extracted": {
          "type": "integer",
          "minimum": 0
        },
        "processing_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "dedup_ratio": {
          "type": "number"
        },
        "pipeline_version": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
